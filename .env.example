# StudySpace — Environment variables
# Copy this to .env and fill in your values.

# ----------------------------------------------------------------------
# Supabase (required)
# Create a project at https://supabase.com, then copy Project URL and anon key
# from Project Settings → API. For HS256 JWT verification, also set the
# JWT secret from Project Settings → API → JWT Secret.
# ----------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret-that-is-very-long-for-hs256
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# ----------------------------------------------------------------------
# Postgres (required for backend + worker)
# Use the direct connection string from Supabase Settings → Database.
# Format: postgresql://postgres:password@host:5432/postgres
# If using Supabase's connection pooler, use port 6543 and add ?pgbouncer=true
# ----------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DB_USER_ROLE=authenticated
DB_POOL_MIN=1
DB_POOL_MAX=10

# ----------------------------------------------------------------------
# Redis (required for rate limiting + ARQ worker)
# ----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------
# LLM / Embeddings (via LiteLLM — provider-agnostic)
# Default: OpenAI. Set LITELLM_API_KEY to your OpenAI API key.
# To use a LiteLLM proxy or alternative provider, set LITELLM_BASE_URL.
# ----------------------------------------------------------------------
LITELLM_MODEL=gpt-4o-mini
LITELLM_JUDGE_MODEL=gpt-4o-mini
LITELLM_API_KEY=sk-your-openai-key
LITELLM_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64
LLM_MAX_OUTPUT_TOKENS=1200
ASSISTANT_NAME=StudySpace

# ----------------------------------------------------------------------
# RAG pipeline tuning
# ----------------------------------------------------------------------
RAG_VECTOR_CANDIDATES=50
RAG_FTS_CANDIDATES=50
RAG_RRF_K=60
RAG_TOP_K=6
RERANKER=lexical
RERANKER_MODEL=rerank-english-v3.0
RELEVANCE_THRESHOLD=0.30
CHUNK_TARGET_CHARS=2600
CHUNK_OVERLAP_CHARS=300

# Hallucination protection layers (independently switchable)
LAYER_RELEVANCE_GATE=true
LAYER_CITATION_VALIDATION=true
LAYER_CLAIM_VERIFICATION=true

# ----------------------------------------------------------------------
# Upload limits
# ----------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PAGES=300
MAX_PASTED_CHARS=100000
STORAGE_QUOTA_MB=500
# Longest source title accepted on upload, in characters.
MAX_SOURCE_TITLE=200
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.markdown
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,application/octet-stream

# ----------------------------------------------------------------------
# Rate limits (per user unless noted)
# ----------------------------------------------------------------------
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_5MIN=10
RATE_LIMIT_STUDIO_PER_10MIN=15
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_CLIENT_ERRORS_PER_MIN=30
RATE_LIMIT_VITALS_PER_MIN=60

# ----------------------------------------------------------------------
# CORS (comma-separated)
# ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------------------
# Runtime environment
# development | test | production. Settings.env gates the generated API
# reference: /docs and /openapi.json are served outside production only.
# Local runs default to development; the Docker image defaults to
# production (override with -e ENV=development).
# ----------------------------------------------------------------------
ENV=development
# Service name — the OpenAPI document's title, and the log's.
APP_NAME=StudySpace API
# Reserved: Settings reads it, nothing acts on it yet.
DEBUG=false

# ----------------------------------------------------------------------
# Logging
# Threshold for application output. The request log writes one line per
# request at INFO, 4xx at WARNING and 5xx at ERROR, so INFO is the
# normal operating picture and WARNING is what you ask for when
# something is wrong.
# ----------------------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# Langfuse (optional — tracing & evals)
# Create a project at https://cloud.langfuse.com
# ----------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# ----------------------------------------------------------------------
# Demo workspace
# ----------------------------------------------------------------------
DEMO_ENABLED=true

# ----------------------------------------------------------------------
# Admin emails (comma-separated) — get /evals access
# ----------------------------------------------------------------------
ADMIN_EMAILS=you@example.com

# ----------------------------------------------------------------------
# Planner
# ----------------------------------------------------------------------
PLANNER_HORIZON_DAYS=21
PLANNER_MAX_TASKS=14

# ----------------------------------------------------------------------
# MCP token prefix
# ----------------------------------------------------------------------
MCP_TOKEN_PREFIX=ssk_

# ----------------------------------------------------------------------
# Frontend (Vite)
# ----------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000/api
