# Normalise line endings so Windows and macOS checkouts don't churn every file.
* text=auto eol=lf

# Explicitly binary — never rewrite these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# Shell scripts must stay executable and LF, or they fail in CI containers.
*.sh text eol=lf

# Windows entry points keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles are machine-generated: never let a formatter touch them.
package-lock.json -diff linguist-generated=true
pnpm-lock.yaml -diff linguist-generated=true
yarn.lock -diff linguist-generated=true
