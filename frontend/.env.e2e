# Environment for the end-to-end suite.
#
# Loaded by `vite build --mode e2e` (see the test:e2e script). Vite reads
# .env first and lets this file override it, so only what differs is listed
# here.
#
# Why it exists: the production Content-Security-Policy allows connect-src
# 'self', https: and wss:, and nothing else. The local .env points Supabase
# and the API at plain http on 127.0.0.1 — which that policy refuses before
# the request is dispatched at all, so Playwright's route stubs never see it.
# (This was found the slow way: sign-in silently stayed on /auth, with the
# CSP violation in the console as the only trace.)
#
# Both hosts below are https origins that no packet leaves for: every
# request to them is answered by e2e/support.js inside the browser process.
# A real deployment points these at real https endpoints and changes nothing
# else. The build itself is otherwise identical to `npm run build` — same
# production mode, same NODE_ENV, same minifier; only these strings differ.
VITE_SUPABASE_URL=https://supabase.e2e.test
VITE_SUPABASE_ANON_KEY=e2e-anon-key
VITE_API_URL=https://api.e2e.test/api

# Left blank so no test has to wait on Google being reachable.
VITE_GA_ID=
